{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@minigo/wallet-sdk/*": [
        "../../packages/wallet-sdk/src/*"
      ],
      "@stellar/stellar-base": [
        "../../node_modules/@stellar/stellar-base"
      ]
    },
    "allowImportingTsExtensions": true
  }
}
